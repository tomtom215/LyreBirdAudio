# MediaMTX RTSP Server systemd Service
# High-performance RTSP/RTMP/HLS/WebRTC media server
#
# ONE template. `sudo ./install_mediamtx.sh install` renders it into
# /etc/systemd/system/mediamtx.service; copying it there by hand
#   sudo cp config/mediamtx.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable mediamtx
#   sudo systemctl start mediamtx
# works when MediaMTX is at /usr/local/bin/mediamtx with its configuration in
# /etc/mediamtx/mediamtx.yml (it then runs as root). The values below are those
# defaults. The installer replaces them where they differ and changes nothing else:
#   - ExecStart=       the MediaMTX binary and its configuration file
#   - `# User=mediamtx` and `# Group=mediamtx` become User= and Group= lines: the
#                      service account the installer created
#   - WorkingDirectory=  the state directory
#   - ReadWritePaths=  /var/log, the state directory and the configuration directory
#   - StandardOutput=, StandardError=  the installer sends the log to the journal
#                      (journalctl -u mediamtx), which rotates itself; the file below
#                      suits the by-hand install together with
#                      config/lyrebird-logrotate.conf
# Change anything else with `systemctl edit mediamtx` (a drop-in), not here.

[Unit]
Description=MediaMTX RTSP Media Server
Documentation=https://github.com/bluenviron/mediamtx
After=network-online.target
Wants=network-online.target
# For MediaMTX-only installs. mediamtx-audio.service (the LyreBirdAudio stream
# manager) runs its own MediaMTX with the FFmpeg streams on the same ports and the
# same configuration file: the two cannot run together, and starting one stops
# the other. (The stream manager refuses to start beside a running mediamtx.service.)
Conflicts=mediamtx-audio.service

# Limit restart frequency (max 5 restarts in 300 seconds). These belong in
# [Unit]; systemd IGNORES StartLimitIntervalSec in [Service], so the rate limit
# there would silently not apply (a crash-looping binary could restart forever).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/mediamtx /etc/mediamtx/mediamtx.yml
# No ExecReload=: MediaMTX re-reads its configuration file by itself when the
# file changes (edit it and the change is applied, no signal needed). It does not
# handle SIGHUP: that signal ends the process.

# Working directory
WorkingDirectory=/var/lib/mediamtx
# systemd creates /var/lib/mediamtx (owned by the service account) before the
# process starts, so a node whose state directory was removed still starts
StateDirectory=mediamtx

# User/Group: run as a non-root account (the installer creates "mediamtx" and
# activates these two lines; by hand, create the account and uncomment them)
# User=mediamtx
# Group=mediamtx

# Restart policy for 24/7 operation: whatever ends MediaMTX, it is started again
# (with the start limit above). No RestartPreventExitStatus=: a SIGTERM sent by
# something else than systemd must not leave an unattended node down.
Restart=always
RestartSec=5

# NOTE: no WatchdogSec here on purpose. MediaMTX does not implement the systemd
# sd_notify watchdog protocol, so a WatchdogSec would never receive a keep-alive
# and systemd would kill+restart MediaMTX every interval (dropping every stream).
# Recovery is handled by Restart=always plus the LyreBird cron health monitor.

# Give time for graceful shutdown
TimeoutStopSec=15

# Increase file descriptor limit for many concurrent streams
LimitNOFILE=65535

# Increase core dump size for debugging (0 to disable)
LimitCORE=0

# Security hardening
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/log /var/lib/mediamtx /etc/mediamtx
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Resource limits for production stability
MemoryMax=512M
MemoryHigh=400M

# Logging
StandardOutput=append:/var/log/mediamtx.out
StandardError=append:/var/log/mediamtx.out
SyslogIdentifier=mediamtx

[Install]
WantedBy=multi-user.target
